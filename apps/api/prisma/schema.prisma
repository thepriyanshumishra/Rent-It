// RentIt Database Schema
// Financial amounts stored in PAISE (integer) to avoid floating-point errors
// 1 INR = 100 paise

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer     Customer?
  refreshTokens RefreshToken[]
  auditEvents  AuditEvent[]    @relation("ActorEvents")
  createdRentals Rental[]      @relation("CreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  rentals   Rental[]
  cart      Cart?
  quotations Quotation[]

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  label      String   @default("Home")
  line1      String   @map("line1")
  line2      String?  @map("line2")
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fulfillments Fulfillment[]

  @@index([customerId])
  @@map("addresses")
}

// ─────────────────────────────────────────
// PRODUCT CATALOG
// ─────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@map("product_categories")
}

model Product {
  id              String        @id @default(uuid())
  categoryId      String        @map("category_id")
  name            String
  slug            String        @unique
  description     String?
  shortDesc       String?       @map("short_desc")
  status          ProductStatus @default(DRAFT)
  depositAmountPaise Int         @default(0) @map("deposit_amount_paise")
  imageUrls       String[]      @map("image_urls")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  category        ProductCategory   @relation(fields: [categoryId], references: [id])
  attributes      ProductAttribute[]
  inventoryItems  InventoryItem[]
  priceRules      PriceRule[]
  cartItems       CartItem[]
  rentalItems     RentalItem[]
  quotationItems  QuotationItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String @map("product_id")
  key       String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

// ─────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────

enum InventoryStatus {
  AVAILABLE
  RESERVED
  RENTED
  UNDER_INSPECTION
  UNDER_REPAIR
  UNAVAILABLE
  RETIRED
}

model InventoryItem {
  id           String          @id @default(uuid())
  productId    String          @map("product_id")
  serialNumber String?         @map("serial_number")
  status       InventoryStatus @default(AVAILABLE)
  condition    String?
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id])
  rentalItems RentalItem[]
  repairs     Repair[]

  @@index([productId])
  @@index([status])
  @@map("inventory_items")
}

// ─────────────────────────────────────────
// PRICING
// ─────────────────────────────────────────

enum DurationUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

model Pricelist {
  id         String   @id @default(uuid())
  name       String
  isDefault  Boolean  @default(false) @map("is_default")
  currency   String   @default("INR")
  validFrom  DateTime? @map("valid_from")
  validUntil DateTime? @map("valid_until")
  createdAt  DateTime @default(now()) @map("created_at")

  rules PriceRule[]

  @@map("pricelists")
}

model PriceRule {
  id            String       @id @default(uuid())
  pricelistId   String       @map("pricelist_id")
  productId     String       @map("product_id")
  durationUnit  DurationUnit @map("duration_unit")
  durationValue Int          @default(1) @map("duration_value")
  ratePaise     Int          @map("rate_paise")
  createdAt     DateTime     @default(now()) @map("created_at")

  pricelist Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([pricelistId])
  @@index([productId])
  @@map("price_rules")
}

// ─────────────────────────────────────────
// CART
// ─────────────────────────────────────────

model Cart {
  id         String   @id @default(uuid())
  customerId String   @unique @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

// ─────────────────────────────────────────
// RENTALS
// ─────────────────────────────────────────

enum RentalStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  SCHEDULED
  ACTIVE
  OVERDUE
  RETURNED
  UNDER_INSPECTION
  PENDING_SETTLEMENT
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  STORE_PICKUP
  DELIVERY
}

model Rental {
  id               String       @id @default(uuid())
  rentalNumber     String       @unique @map("rental_number")
  customerId       String       @map("customer_id")
  status           RentalStatus @default(DRAFT)
  fulfillmentType  FulfillmentType @map("fulfillment_type")
  startDate        DateTime     @map("start_date")
  endDate          DateTime     @map("end_date")
  actualReturnDate DateTime?    @map("actual_return_date")
  subtotalPaise    Int          @default(0) @map("subtotal_paise")
  depositTotalPaise Int         @default(0) @map("deposit_total_paise")
  lateFeesPaise    Int          @default(0) @map("late_fees_paise")
  totalPaise       Int          @default(0) @map("total_paise")
  notes            String?
  createdById      String?      @map("created_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  customer       Customer         @relation(fields: [customerId], references: [id])
  createdBy      User?            @relation("CreatedBy", fields: [createdById], references: [id])
  items          RentalItem[]
  payments       Payment[]
  deposits       SecurityDeposit[]
  charges        Charge[]
  settlement     Settlement?
  fulfillment    Fulfillment?
  returnRecord   Return?
  inspection     Inspection?
  auditEvents    AuditEvent[]

  @@index([customerId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("rentals")
}

model RentalItem {
  id              String  @id @default(uuid())
  rentalId        String  @map("rental_id")
  productId       String  @map("product_id")
  inventoryItemId String? @map("inventory_item_id")
  quantity        Int     @default(1)
  unitPricePaise  Int     @map("unit_price_paise")
  totalPaise      Int     @map("total_paise")

  rental        Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([rentalId])
  @@index([inventoryItemId])
  @@map("rental_items")
}

// ─────────────────────────────────────────
// FINANCIAL
// ─────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  SIMULATED
  RAZORPAY
  CASH
  BANK_TRANSFER
}

model Payment {
  id            String        @id @default(uuid())
  rentalId      String        @map("rental_id")
  amountPaise   Int           @map("amount_paise")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(SIMULATED)
  providerRef   String?       @map("provider_ref")
  idempotencyKey String       @unique @map("idempotency_key")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@map("payments")
}

enum DepositStatus {
  HELD
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  FORFEITED
  SETTLED
}

model SecurityDeposit {
  id            String        @id @default(uuid())
  rentalId      String        @map("rental_id")
  amountPaise   Int           @map("amount_paise")
  status        DepositStatus @default(HELD)
  settledAt     DateTime?     @map("settled_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@map("security_deposits")
}

enum ChargeType {
  LATE_FEE
  DAMAGE
  MISSING_ITEM
  OTHER
}

model Charge {
  id          String     @id @default(uuid())
  rentalId    String     @map("rental_id")
  type        ChargeType
  amountPaise Int        @map("amount_paise")
  reason      String
  createdAt   DateTime   @default(now()) @map("created_at")

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@map("charges")
}

enum SettlementStatus {
  PENDING
  COMPLETED
}

model Settlement {
  id                   String           @id @default(uuid())
  rentalId             String           @unique @map("rental_id")
  totalChargesPaise    Int              @map("total_charges_paise")
  depositDeductedPaise Int              @map("deposit_deducted_paise")
  refundAmountPaise    Int              @map("refund_amount_paise")
  status               SettlementStatus @default(PENDING)
  notes                String?
  settledAt            DateTime?        @map("settled_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  rental Rental @relation(fields: [rentalId], references: [id])

  @@map("settlements")
}

// ─────────────────────────────────────────
// FULFILLMENT & RETURN
// ─────────────────────────────────────────

enum FulfillmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Fulfillment {
  id          String             @id @default(uuid())
  rentalId    String             @unique @map("rental_id")
  type        FulfillmentType
  status      FulfillmentStatus  @default(SCHEDULED)
  addressId   String?            @map("address_id")
  scheduledAt DateTime?          @map("scheduled_at")
  completedAt DateTime?          @map("completed_at")
  notes       String?

  rental  Rental   @relation(fields: [rentalId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])

  @@map("fulfillments")
}

model Return {
  id            String   @id @default(uuid())
  rentalId      String   @unique @map("rental_id")
  returnedAt    DateTime @map("returned_at")
  returnedById  String   @map("returned_by_id")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  rental     Rental      @relation(fields: [rentalId], references: [id])
  inspection Inspection?

  @@map("returns")
}

// ─────────────────────────────────────────
// INSPECTION
// ─────────────────────────────────────────

enum InspectionResult {
  OK
  DAMAGED
  MISSING_ITEMS
  DAMAGED_AND_MISSING
}

model Inspection {
  id        String           @id @default(uuid())
  returnId  String           @unique @map("return_id")
  rentalId  String           @unique @map("rental_id")
  result    InspectionResult
  notes     String?
  inspectedById String       @map("inspected_by_id")
  createdAt DateTime         @default(now()) @map("created_at")

  return  Return   @relation(fields: [returnId], references: [id])
  rental  Rental   @relation(fields: [rentalId], references: [id])
  damages Damage[]

  @@map("inspections")
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
  TOTAL_LOSS
}

model Damage {
  id            String         @id @default(uuid())
  inspectionId  String         @map("inspection_id")
  description   String
  severity      DamageSeverity
  chargeAmountPaise Int        @map("charge_amount_paise")
  createdAt     DateTime       @default(now()) @map("created_at")

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("damages")
}

// ─────────────────────────────────────────
// REPAIRS
// ─────────────────────────────────────────

enum RepairStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Repair {
  id              String       @id @default(uuid())
  inventoryItemId String       @map("inventory_item_id")
  reason          String
  status          RepairStatus @default(PENDING)
  priority        Int          @default(2)
  estimatedCostPaise Int?      @map("estimated_cost_paise")
  notes           String?
  startedAt       DateTime?    @map("started_at")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([status])
  @@map("repairs")
}

// ─────────────────────────────────────────
// QUOTATIONS
// ─────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
  CONVERTED
}

model Quotation {
  id          String          @id @default(uuid())
  customerId  String          @map("customer_id")
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime        @map("valid_until")
  notes       String?
  totalPaise  Int             @default(0) @map("total_paise")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id])
  items    QuotationItem[]

  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id             String   @id @default(uuid())
  quotationId    String   @map("quotation_id")
  productId      String   @map("product_id")
  quantity       Int      @default(1)
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  unitPricePaise Int      @map("unit_price_paise")
  totalPaise     Int      @map("total_paise")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@map("quotation_items")
}

// ─────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  rentalId   String?  @map("rental_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor  User?   @relation("ActorEvents", fields: [actorId], references: [id])
  rental Rental? @relation(fields: [rentalId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([rentalId])
  @@map("audit_events")
}
