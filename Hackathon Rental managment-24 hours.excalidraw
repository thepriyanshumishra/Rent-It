      "seed": 232553131,
      "version": 1986,
      "versionNonce": 183027024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784277956799,
      "link": null,
      "locked": false,
      "text": "-Create a new user in the database upon sign-up.\n\n- To create a new user, ensure the following conditions are met:\n\n- The email ID must be unique.\n\n- The password must be unique.\n\n- The password length should be between 6 and 12 characters and must include:\n\n- At least one uppercase letter\n\n- At least one lowercase letter\n\n- At least one special character (@, $, &, _)\n\n- The Password and Confirm Password fields must match.",
      "fontSize": 20.8396863133,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-Create a new user in the database upon sign-up.\n\n- To create a new user, ensure the following conditions are met:\n\n- The email ID must be unique.\n\n- The password must be unique.\n\n- The password length should be between 6 and 12 characters and must include:\n\n- At least one uppercase letter\n\n- At least one lowercase letter\n\n- At least one special character (@, $, &, _)\n\n- The Password and Confirm Password fields must match.",
      "autoResize": true,
      "lineHeight": 1.25
    },
