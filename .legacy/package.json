{
  "name": "rentit",
  "version": "0.0.1",
  "private": true,
  "description": "RentIt — Rental Management Platform",
  "packageManager": "pnpm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './apps/*' lint",
    "typecheck": "pnpm --filter './apps/*' typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}